# Copy to .env.local (git-ignored) for `supabase functions serve --env-file supabase/functions/.env.local`.
# CRON_SECRET authenticates pg_cron's calls to resume, send-messages, render-pdfs and send-campaigns (the Vault secret cron_secret must equal it).
CRON_SECRET=
APP_URL=http://localhost:5173/app/
EMAIL_TRANSPORT=mailpit
EMAIL_FROM=ReportNoReport <noreply@reportnoreport.local>
MAILPIT_URL=http://host.docker.internal:54324
# Only with EMAIL_TRANSPORT=resend (hosted): a Resend API key, set as a function secret, never committed.
RESEND_API_KEY=
# Campaigns: the public URL of the unsubscribe function (one-click POST; the page itself is APP_URL's origin + /unsubscribe), and the secret that signs its links (32+ characters).
UNSUBSCRIBE_URL=http://127.0.0.1:54321/functions/v1/unsubscribe
UNSUBSCRIBE_SECRET=
# The whsec_ signing secret from the Resend webhook page (hosted), or any whsec_ value locally for scripts/webhook-event.mjs.
RESEND_WEBHOOK_SECRET=
